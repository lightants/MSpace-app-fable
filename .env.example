# Copy this file to .env and fill in the values.

# Port the site runs on
PORT=4600

# Public address customers reach after scanning the QR (used in emails and the poster QR).
# Example once deployed: https://book.mspace.ph
PUBLIC_URL=http://localhost:4600

# Admin dashboard password (open /admin in the browser)
ADMIN_PASSWORD=change-me-now

# Random string used to sign the admin login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Email sending (Gmail: create an App Password at https://myaccount.google.com/apppasswords)
# Leave SMTP_HOST blank to run in "dry-run" mode: emails are logged in the admin Email Log instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mspacemind@gmail.com
SMTP_PASS=
MAIL_FROM="MSpace <mspacemind@gmail.com>"

# Owner notification address (gets a note when a new payment is submitted)
OWNER_EMAIL=mspacemind@gmail.com

# "Sign in with Google" (step 3: customers sign up with their Gmail before booking).
# Create an OAuth Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# and add your PUBLIC_URL (and http://localhost:4600 for testing) to "Authorized JavaScript origins".
# Leave blank to fall back to a simple name + email sign-up form.
GOOGLE_CLIENT_ID=
